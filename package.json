{
  "name": "baya-cli",
  "version": "1.1.0",
  "description": "Local multi-provider CLI orchestrator: a plain-text task list to LLM-planned JSON DAG to parallel dispatch across local agent CLIs.",
  "type": "module",
  "license": "MIT",
  "author": "Julio Cesar Martin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juliomatcom/baya-cli.git"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "baya": "dist/cli/bin.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:contract": "BAYA_CONTRACT=1 node --experimental-vm-modules node_modules/.bin/jest --config jest.contract.config.js",
    "release": "semantic-release"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.0",
    "chalk": "^6.0.0",
    "ora": "^9.4.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@swc/core": "^1.10.0",
    "@swc/jest": "^0.2.37",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.13.3",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "semantic-release": "^25.0.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  }
}
